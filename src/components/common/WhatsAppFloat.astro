---
const WHATSAPP_NUMBER = '8613922332584';
const message = 'Hola YOLEC, quiero una cotización de pequeños electrodomésticos OEM.';
const href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
---

<a
  href={href}
  class="wa-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chatear por WhatsApp"
  title="Chatear por WhatsApp"
>
  <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true" focusable="false">
    <path
      d="M16.03 4C9.4 4 4 9.4 4 16.03c0 2.12.55 4.19 1.6 6.01L4 28l6.13-1.61a12 12 0 0 0 5.9 1.51h.01C22.66 27.9 28 22.5 28 15.87 28 9.25 22.66 4 16.03 4zm0 21.9h-.01a9.9 9.9 0 0 1-5.05-1.38l-.36-.21-3.64.95.97-3.55-.24-.37a9.87 9.87 0 0 1-1.51-5.28c0-5.46 4.44-9.9 9.9-9.9 2.64 0 5.13 1.03 7 2.9a9.83 9.83 0 0 1 2.9 7c0 5.46-4.44 9.9-9.9 9.9z"
    ></path>
    <path
      d="M19.11 17.27c-.29-.15-1.72-.85-1.99-.95-.27-.1-.46-.15-.66.15-.2.29-.78.95-.95 1.14-.17.2-.35.22-.64.07-.29-.15-1.22-.45-2.32-1.43-.86-.77-1.44-1.72-1.61-2.01-.17-.29-.02-.45.13-.6.13-.13.29-.35.44-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.91-2.19-.24-.58-.48-.5-.66-.51-.17 0-.37-.01-.56-.01-.2 0-.52.07-.79.37-.27.29-1.03 1.01-1.03 2.46 0 1.45 1.06 2.85 1.2 3.05.15.2 2.07 3.16 5.02 4.43.7.3 1.25.48 1.68.61.71.23 1.35.2 1.86.12.57-.08 1.72-.7 1.96-1.38.24-.68.24-1.26.17-1.38-.07-.12-.27-.19-.56-.34z"
    ></path>
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    z-index: 9998;
    right: clamp(16px, 2.5vw, 28px);
    bottom: max(18px, calc(env(safe-area-inset-bottom) + 12px));
    width: 60px;
    height: 60px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #25d366;
    border: 2px solid rgb(255 255 255 / 0.92);
    color: #fff;
    box-shadow: 0 10px 26px rgb(18 140 74 / 0.4);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      background-color 0.22s ease;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .wa-float svg {
    width: 30px;
    height: 30px;
  }

  .wa-float:hover {
    background: #1ebe5d;
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 15px 32px rgb(18 140 74 / 0.5);
  }

  .wa-float:focus-visible {
    outline: 3px solid #f5b93f;
    outline-offset: 3px;
  }

  .wa-float::before {
    content: 'Chatear por WhatsApp';
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    transform: translateY(-50%) translateX(6px);
    background: #1f1f1f;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    padding: 9px 13px;
    border-radius: 6px;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.28);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .wa-float:hover::before,
  .wa-float:focus-visible::before {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  @media (max-width: 480px) {
    .wa-float {
      width: 54px;
      height: 54px;
      right: 14px;
      bottom: max(14px, calc(env(safe-area-inset-bottom) + 10px));
    }

    .wa-float svg {
      width: 27px;
      height: 27px;
    }

    .wa-float::before {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float,
    .wa-float::before {
      transition: none;
    }
  }
</style>
