---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import modelsData from '~/data/models.json';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;

// Modelos del catálogo afines al tema del artículo. Mantiene el clúster
// artículo → ficha de producto sin crear páginas nuevas.
const MODEL_CATS: Array<[RegExp, string[]]> = [
  [/olla a presión|pressure cooker|olla presión/, ['pressure-cooker']],
  [/multifunción|multi-cooker/, ['multi-cooker']],
  [/fiambrera|lunch box/, ['electric-lunch-box']],
  [/cuello de cisne|gooseneck|barista|café/, ['electric-coffee-kettle']],
  [/arrocer|rice cooker|bajo azúcar|low sugar/, ['low-sugar-cooker', 'ih-cooker', 'mini-cooker']],
  [/hervidor|kettle/, ['electric-water-kettle', 'glass-electric-kettle']],
];

const postText =
  `${post.title} ${post.category?.title ?? ''} ${(post.tags ?? []).map((t) => t.title).join(' ')}`.toLowerCase();
const modelCats = MODEL_CATS.find(([pattern]) => pattern.test(postText))?.[1] ?? [];
const relatedModels = modelCats.length
  ? modelsData.filter((model) => modelCats.includes(model.category)).slice(0, 4)
  : [];

const toWebp = (src: string) => src.replace(/\.(jpg|jpeg|png)$/i, '.webp');
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header
      class={post.image
        ? 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        : 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'}
    >
      <div class="flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min read
              </>
            )
          }
        </p>
      </div>

      <h1
        class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
      >
        {post.title}
      </h1>
      <p
        class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted dark:text-slate-400 text-justify"
      >
        {post.excerpt}
      </p>

      {
        post.image ? (
          <Image
            src={post.image}
            class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post?.excerpt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>
    <div
      class="mx-auto px-6 sm:px-6 max-w-3xl prose prose-md lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0"
    >
      <slot />
    </div>
    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>
  </article>

  <aside class="mx-auto mt-10 max-w-3xl px-4 sm:px-6">
    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6 dark:border-slate-700 dark:bg-slate-800">
      <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-slate-400">Sobre el autor</p>
      <p class="mt-2 font-bold text-gray-900 dark:text-white">{post.author} · YOLEC Electric</p>
      <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-slate-300">
        Contacto comercial de YOLEC Electric, fabricante OEM/ODM de pequeños electrodomésticos en Zhongshan (China)
        desde 2015. Para dudas de especificación, certificación, muestra o volumen, escriba directamente.
      </p>
      <div class="mt-3 flex flex-wrap gap-4 text-sm">
        <a href="mailto:adrian@yolec-electronics.com" class="font-semibold text-accent hover:underline">
          adrian@yolec-electronics.com
        </a>
        <a href="https://wa.me/8613922332584" class="font-semibold text-accent hover:underline">
          WhatsApp +86 139 2233 2584
        </a>
        <a href="/about" class="font-semibold text-accent hover:underline">Sobre la fábrica</a>
      </div>
    </div>
  </aside>

  {
    relatedModels.length > 0 && (
      <aside class="mx-auto max-w-3xl px-4 sm:px-6 mt-12">
        <h2 class="text-xl font-bold text-gray-900 dark:text-white">Modelos relacionados con este artículo</h2>
        <ul class="mt-5 grid gap-4 sm:grid-cols-2">
          {relatedModels.map((model) => (
            <li>
              <a
                href={`/products/${model.category}/${model.slug}`}
                class="flex items-center gap-4 rounded-xl border border-gray-200 p-3 transition hover:shadow-md dark:border-slate-700 dark:hover:bg-slate-800"
              >
                <picture>
                  <source srcset={toWebp(model.images[0] || '/images/blog/38.jpg')} type="image/webp" />
                  <img
                    src={model.images[0] || '/images/blog/38.jpg'}
                    alt={`${model.titleEs} OEM`}
                    width="750"
                    height="750"
                    class="h-16 w-16 flex-none rounded-lg object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">{model.sku}</p>
                  <h3 class="mt-1 line-clamp-2 text-sm font-bold text-gray-900 dark:text-white">{model.titleEs}</h3>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <a href="/productos" class="mt-5 inline-flex text-sm font-semibold text-accent hover:underline">
          Ver catálogo completo →
        </a>
      </aside>
    )
  }
</section>
