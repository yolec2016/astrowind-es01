---
import { MANUFACTURER_FAQS } from '~/data/manufacturerFaqs';

interface Props {
  category: string;
  title?: string;
}

const { category, title = 'Preguntas frecuentes antes de pedir cotización' } = Astro.props;

const faqs = MANUFACTURER_FAQS[category] ?? [];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

{
  faqs.length > 0 && (
    <>
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

      <section class="bg-white py-16 dark:bg-slate-950 lg:py-20">
        <div class="mx-auto max-w-4xl px-6 lg:px-8">
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">{title}</h2>

          <div class="mt-10 space-y-6">
            {faqs.map((f) => (
              <div class="rounded-xl border border-slate-200 p-6 dark:border-slate-800">
                <h3 class="font-bold text-slate-900 dark:text-white">{f.q}</h3>
                <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">{f.a}</p>
              </div>
            ))}
          </div>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="/contacto"
              class="inline-flex items-center rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-white transition hover:opacity-90"
            >
              Solicitar cotización OEM
            </a>
            <a
              href="/productos"
              class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"
            >
              Ver catálogo de 110 modelos
            </a>
          </div>
        </div>
      </section>
    </>
  )
}
