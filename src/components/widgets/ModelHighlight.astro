---
import modelsData from '~/data/models.json';

interface Props {
  page: string;
  limit?: number;
}

const { page, limit = 12 } = Astro.props;

const CAT2PAGE: Record<string, string> = {
  'electric-coffee-kettle': '/gooseneck-kettle-manufacturer',
  'electric-water-kettle': '/electric-kettle-manufacturer',
  'glass-electric-kettle': '/electric-kettle-manufacturer',
  'electric-health-kettle': '/electric-kettle-manufacturer',
  'electric-kettle-set': '/electric-kettle-manufacturer',
  'breakfast-machine': '/electric-kettle-manufacturer',
  'pressure-cooker': '/electric-pressure-cooker-manufacturer',
  'multi-cooker': '/multi-cooker-manufacturer',
  'mini-cooker': '/electric-rice-cooker-manufacturer',
  'low-sugar-cooker': '/electric-rice-cooker-manufacturer',
  'ih-cooker': '/electric-rice-cooker-manufacturer',
  'electric-lunch-box': '/electric-lunch-box-manufacturer',
};

const models = modelsData.filter((m) => CAT2PAGE[m.category] === page).slice(0, limit);
const total = modelsData.filter((m) => CAT2PAGE[m.category] === page).length;
---

{
  models.length > 0 && (
    <section class="bg-slate-50 py-20 dark:bg-slate-900 lg:py-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">Catálogo</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Modelos destacados OEM
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            {total}
            modelos disponibles para personalización OEM y ODM. Solicite información por modelo, muestras y cotización
            según cantidad.
          </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {models.map((m) => (
            <a
              href={`/products/${m.category}/${m.slug}`}
              class="group overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-slate-800 dark:bg-slate-950"
            >
              <div class="aspect-square overflow-hidden bg-white dark:bg-slate-800">
                <img
                  src={m.images[0] || '/images/blog/38.jpg'}
                  alt={`${m.titleEs} - OEM fabricante en China`}
                  class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              </div>

              <div class="p-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">{m.sku}</p>

                <h3 class="mt-2 line-clamp-2 text-sm font-bold leading-5 text-slate-900 transition group-hover:text-accent dark:text-white">
                  {m.titleEs}
                </h3>

                <p class="mt-3 text-sm font-semibold text-accent">Ver modelo →</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
