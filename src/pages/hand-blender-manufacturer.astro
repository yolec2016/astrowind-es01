---
import Layout from '~/layouts/PageLayout.astro';
import ModelHighlight from '~/components/widgets/ModelHighlight.astro';

const metadata = {
  title: 'Fabricante y proveedor de Batidoras de Mano OEM en China | YOLEC',
  description:
    'Fabricante, proveedor y fábrica de batidoras de mano OEM en China. Motores potentes, accesorios personalizables, CE, CB y RoHS para marcas privadas.',
  ignoreTitleTemplate: true,
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Batidoras de mano OEM/ODM',
  description: metadata.description,
  image: 'https://oemkitchenchina.xyz/images/blog/20.jpg',
  brand: { '@type': 'Brand', name: 'YOLEC Electric' },
  manufacturer: { '@type': 'Organization', name: 'YOLEC Electric' },
  category: 'Hand Blenders',
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <!-- =========================================================
       HERO
  ========================================================== -->

  <section class="relative overflow-hidden bg-slate-50 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-6 py-20 lg:px-8 lg:py-28">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <!-- LEFT -->

        <div>
          <div
            class="mb-6 inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
          >
            Fabricante OEM y ODM · China
          </div>

          <h1 class="text-4xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
            Fabricante de Batidoras de Mano OEM
            <span class="block text-accent"> en China </span>
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
            Fabricamos batidoras de mano para importadores, distribuidores, mayoristas y marcas privadas. Ofrecemos
            fabricación directa, personalización OEM/ODM y juegos de accesorios adaptables a diferentes mercados.
          </p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/contacto"
              class="inline-flex items-center rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
            >
              Solicitar Cotización
            </a>

            <a
              href="https://wa.me/8613922332584"
              class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"
            >
              Hablar por WhatsApp
            </a>
          </div>

          <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4 text-sm text-slate-600 dark:text-slate-400">
            <div>
              <strong class="text-slate-900 dark:text-white">10+</strong>
              años de experiencia
            </div>

            <div>
              <strong class="text-slate-900 dark:text-white">20.000㎡</strong>
              de fábrica
            </div>

            <div>
              <strong class="text-slate-900 dark:text-white">200+</strong>
              empleados
            </div>
          </div>
        </div>

        <!-- RIGHT -->

        <div class="relative">
          <div
            class="overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700"
          >
            <img
              src="/images/blog/20.jpg"
              alt="Fabricante de batidoras de mano en China - hand blender OEM"
              class="h-auto w-full object-cover"
              loading="eager"
            />
          </div>

          <div
            class="absolute -bottom-6 -left-6 hidden rounded-xl bg-white p-5 shadow-xl ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700 sm:block"
          >
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Fabricación directa</p>

            <p class="mt-1 text-lg font-bold text-slate-900 dark:text-white">OEM / ODM</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       TRUST / STATS
  ========================================================== -->

  <section class="border-y border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto grid max-w-6xl grid-cols-2 divide-x divide-slate-200 dark:divide-slate-800 lg:grid-cols-4">
      <div class="px-6 py-8 text-center">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">10+</div>
        <div class="mt-1 text-sm text-slate-500">Años de fabricación</div>
      </div>

      <div class="px-6 py-8 text-center">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">20.000㎡</div>
        <div class="mt-1 text-sm text-slate-500">Superficie de fábrica</div>
      </div>

      <div class="border-t px-6 py-8 text-center dark:border-slate-800 lg:border-t-0">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">200+</div>
        <div class="mt-1 text-sm text-slate-500">Empleados</div>
      </div>

      <div class="border-t px-6 py-8 text-center dark:border-slate-800 lg:border-t-0">
        <div class="text-3xl font-bold text-slate-900 dark:text-white">3</div>
        <div class="mt-1 text-sm text-slate-500">Líneas de producción</div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       PRODUCT RANGE
  ========================================================== -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-accent">Nuestra gama</p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          Batidoras de mano para diferentes segmentos
        </h2>

        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Como fabricante de batidoras de mano, ofrecemos diferentes soluciones para ayudar a importadores y marcas a
          seleccionar el producto adecuado según potencia, accesorios, diseño y precio objetivo.
        </p>
      </div>

      <!-- PRODUCT IMAGE -->

      <div class="mt-12 overflow-hidden rounded-2xl">
        <img
          src="/images/blog/25.jpg"
          alt="Batidoras de mano fabricadas en China para importadores y marcas"
          class="h-auto w-full object-cover"
          loading="lazy"
        />
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">01</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Batidoras básicas</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Modelos compactos y prácticos para segmentos de entrada, con buena relación calidad-precio.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">02</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Con juego de accesorios</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Versiones con vaso medidor, varilla batidora y picador para ampliar el uso en la cocina.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">03</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Brazo de acero inoxidable</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Barras de acero inoxidable y velocidades variables para un uso más profesional y duradero.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7 dark:border-slate-800 dark:bg-slate-900">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">04</div>

          <h3 class="mt-5 text-xl font-bold text-slate-900 dark:text-white">Marca privada</h3>

          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-400">
            Productos personalizables con logotipo, color, acabado, packaging y otras especificaciones.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
     RELATED PRODUCTS
========================================================== -->

  <section class="mt-20 border-t border-slate-200 pt-20 dark:border-slate-800">
    <div class="mx-auto max-w-6xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent">Otras soluciones OEM y ODM</p>

      <h3 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Explore nuestros otros pequeños electrodomésticos
      </h3>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-400">
        Además de batidoras de mano, ofrecemos soluciones de fabricación OEM y ODM para otras categorías de pequeños
        electrodomésticos.
      </p>

      <div class="mx-auto mt-12 grid max-w-5xl gap-5 md:grid-cols-3">
        <!-- Electric Kettle -->

        <a
          href="/electric-kettle-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 01 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h4 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Kettle Manufacturer
          </h4>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Hervidores eléctricos OEM y ODM para importadores, distribuidores y marcas privadas.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Ver solución →</div>
        </a>

        <!-- Rice Cooker -->

        <a
          href="/electric-rice-cooker-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 02 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h4 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Rice Cooker Manufacturer
          </h4>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Arroceras eléctricas OEM y ODM para proyectos de importación y marca privada.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Ver solución →</div>
        </a>

        <!-- Lunch Box -->

        <a
          href="/electric-lunch-box-manufacturer"
          class="group rounded-2xl border border-slate-200 bg-slate-50 px-7 py-8 text-left transition duration-300 hover:-translate-y-1 hover:border-accent/30 hover:bg-white hover:shadow-lg dark:border-slate-800 dark:bg-slate-900 dark:hover:bg-slate-800"
        >
          <div class="flex items-start justify-between">
            <span class="text-sm font-semibold text-slate-400"> 03 </span>

            <span
              class="text-xl text-slate-300 transition duration-300 group-hover:translate-x-1 group-hover:text-accent"
            >
              →
            </span>
          </div>

          <h4 class="mt-7 text-xl font-bold text-slate-900 transition group-hover:text-accent dark:text-white">
            Electric Lunch Box Manufacturer
          </h4>

          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
            Fiambreras eléctricas OEM y ODM para mayoristas, distribuidores y marcas internacionales.
          </p>

          <div class="mt-6 text-sm font-semibold text-accent">Ver solución →</div>
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================
       WHY CHOOSE YOLEC
  ========================================================== -->

  <section class="bg-slate-50 py-20 dark:bg-slate-900 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">Fabricante directo</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Más que un proveedor de batidoras de mano
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            Para un comprador B2B, elegir un fabricante significa evaluar mucho más que el precio. La estabilidad de
            producción, el control de calidad, la capacidad de personalización y la comunicación también afectan
            directamente al éxito de su proyecto.
          </p>

          <p class="mt-5 leading-7 text-slate-600 dark:text-slate-400">
            YOLEC Electric trabaja directamente con importadores, distribuidores y marcas internacionales para
            desarrollar batidoras de mano adaptadas a sus necesidades comerciales.
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Fabricación directa</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Comunicación directa con la fábrica durante todo el proyecto.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">I+D propio</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Soporte técnico para adaptar y desarrollar productos.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Control de calidad</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Inspecciones durante las diferentes etapas de fabricación.
            </p>
          </div>

          <div class="rounded-2xl bg-white p-6 shadow-sm dark:bg-slate-800">
            <div class="text-lg font-bold text-slate-900 dark:text-white">Producción estable</div>

            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              Capacidad para apoyar pedidos OEM de diferentes volúmenes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       OEM ODM
  ========================================================== -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <div class="overflow-hidden rounded-2xl">
          <img
            src="/images/blog/40.jpg"
            alt="Fabricación OEM y ODM de batidoras de mano personalizadas"
            class="w-full object-cover"
            loading="lazy"
          />
        </div>

        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">OEM / ODM</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Personalice su batidora de mano según su marca
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            Un proyecto OEM no tiene que empezar desde cero. Puede seleccionar un modelo existente y personalizar los
            elementos necesarios para adaptarlo a su mercado.
          </p>

          <div class="mt-8 space-y-5">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Logotipo y marca</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Personalización de logotipo y elementos de identidad visual.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Colores y acabados</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Diferentes opciones para adaptar el producto a su línea de marca.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Funciones y accesorios</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Potencia, velocidades, vaso, varilla, picador y otros accesorios según el modelo y el proyecto.
              </p>
            </div>

            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Packaging</h3>
              <p class="mt-1 text-slate-600 dark:text-slate-400">
                Cajas, manuales, etiquetas y materiales de presentación.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       FACTORY
  ========================================================== -->

  <section class="bg-slate-900 py-20 text-white lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-widest text-slate-400">Capacidad de fabricación</p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Una fábrica preparada para proyectos OEM de batidoras de mano
        </h2>

        <p class="mt-5 text-lg leading-8 text-slate-300">
          Nuestra infraestructura permite controlar diferentes etapas del proceso de fabricación y responder a las
          necesidades de compradores internacionales.
        </p>
      </div>

      <!-- FACTORY IMAGE -->

      <div class="mt-12 overflow-hidden rounded-2xl">
        <img
          src="/images/blog/55.jpg"
          alt="Fábrica de batidoras de mano OEM en China"
          class="h-auto w-full object-cover"
          loading="lazy"
        />
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-700 p-7">
          <div class="text-4xl font-bold">20.000㎡</div>

          <h3 class="mt-4 text-xl font-bold">Instalaciones</h3>

          <p class="mt-3 leading-7 text-slate-400">Espacio de fabricación y operaciones para proyectos OEM y ODM.</p>
        </div>

        <div class="rounded-2xl border border-slate-700 p-7">
          <div class="text-4xl font-bold">200+</div>

          <h3 class="mt-4 text-xl font-bold">Empleados</h3>

          <p class="mt-3 leading-7 text-slate-400">Equipos de producción, ingeniería, calidad y operaciones.</p>
        </div>

        <div class="rounded-2xl border border-slate-700 p-7">
          <div class="text-4xl font-bold">3</div>

          <h3 class="mt-4 text-xl font-bold">Líneas de producción</h3>

          <p class="mt-3 leading-7 text-slate-400">Capacidad para gestionar pedidos OEM de diferentes volúmenes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       MANUFACTURING
  ========================================================== -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">Fabricación</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Controlamos el proceso de fabricación de principio a fin
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            Una fabricación estable requiere coordinación entre ingeniería, producción y control de calidad. Nuestro
            equipo trabaja para mantener la consistencia durante cada etapa del pedido.
          </p>
        </div>

        <div class="overflow-hidden rounded-2xl">
          <img
            src="/images/blog/38.jpg"
            alt="Proceso de fabricación de batidoras de mano en China"
            class="h-auto w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================
       QUALITY & CERTIFICATIONS
  ========================================================== -->

  <section class="bg-white py-20 dark:bg-slate-950 lg:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-accent">Calidad y cumplimiento</p>

          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            Control de calidad para una producción consistente
          </h2>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
            Para importadores y distribuidores, una calidad estable entre diferentes lotes es fundamental. Nuestro
            equipo de calidad supervisa diferentes etapas del proceso de fabricación.
          </p>

          <div class="mt-8 space-y-4">
            <div class="rounded-xl border border-slate-200 p-5 dark:border-slate-800">
              <strong class="text-slate-900 dark:text-white"> Inspección de materiales </strong>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                Control de materiales y componentes según los requisitos del proyecto.
              </p>
            </div>

            <div class="rounded-xl border border-slate-200 p-5 dark:border-slate-800">
              <strong class="text-slate-900 dark:text-white"> Control durante producción </strong>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                Seguimiento de producción para detectar problemas a tiempo.
              </p>
            </div>

            <div class="rounded-xl border border-slate-200 p-5 dark:border-slate-800">
              <strong class="text-slate-900 dark:text-white"> Inspección final </strong>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
                Verificación del producto antes del embalaje y envío.
              </p>
            </div>
