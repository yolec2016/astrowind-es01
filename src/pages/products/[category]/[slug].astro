---
import { getCollection } from 'astro:content';

import Layout from '~/layouts/PageLayout.astro';
import modelsData from '~/data/models.json';
import { CAT_CONTENT } from '~/data/productContent';
import { describeAttributes } from '~/data/modelAttrs';

export async function getStaticPaths() {
  return modelsData.map((model) => ({
    params: { category: model.category, slug: model.slug },
    props: {
      model,
      siblings: modelsData.filter((m) => m.category === model.category && m.sku !== model.sku).slice(0, 4),
    },
  }));
}

const { model, siblings } = Astro.props;

const CAT_PAGE: Record<string, string> = {
  'electric-coffee-kettle': '/gooseneck-kettle-manufacturer',
  'electric-water-kettle': '/electric-kettle-manufacturer',
  'glass-electric-kettle': '/electric-kettle-manufacturer',
  'electric-health-kettle': '/electric-kettle-manufacturer',
  'electric-kettle-set': '/electric-kettle-manufacturer',
  'breakfast-machine': '/electric-kettle-manufacturer',
  'pressure-cooker': '/electric-pressure-cooker-manufacturer',
  'multi-cooker': '/multi-cooker-manufacturer',
  'mini-cooker': '/electric-rice-cooker-manufacturer',
  'low-sugar-cooker': '/electric-rice-cooker-manufacturer',
  'ih-cooker': '/electric-rice-cooker-manufacturer',
  'electric-lunch-box': '/electric-lunch-box-manufacturer',
};
const catPage = CAT_PAGE[model.category] || '/electric-kettle-manufacturer';

const SPEC_LABELS: Record<string, string> = {
  Capacity: 'Capacidad',
  Power: 'Potencia',
  'Voltage/Frequency': 'Voltaje / Frecuencia',
  'Inner Material': 'Material interno',
  Material: 'Material',
  Certifications: 'Certificaciones',
  'Body Material': 'Material del cuerpo',
  'Lid Material': 'Material de la tapa',
};

const VALUE_DICT: [RegExp, string][] = [
  [/Food-Grade|Food Grade/gi, 'grado alimenticio'],
  [/Stainless Steel/gi, 'Acero inoxidable'],
  [/Glass/gi, 'Vidrio'],
  [/Black/gi, 'negro'],
  [/White/gi, 'blanco'],
  [/Cream/gi, 'crema'],
  [/Green/gi, 'verde'],
];
const trVal = (s: string) => VALUE_DICT.reduce((acc, [re, es]) => acc.replace(re, es), s);

const toWebp = (src: string) => src.replace(/\.(jpg|jpeg|png)$/i, '.webp');

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: model.titleEs,
  description: model.descEs,
  image: model.images.map((i) => 'https://oemkitchenchina.xyz' + i),
  sku: model.sku,
  category: model.catEs,
  brand: { '@type': 'Brand', name: 'YOLEC Electric' },
  manufacturer: { '@type': 'Organization', name: 'YOLEC Electric' },
};

const CAT_NAME: Record<string, string> = {
  '/electric-kettle-manufacturer': 'Hervidores eléctricos',
  '/gooseneck-kettle-manufacturer': 'Hervidores cuello de cisne',
  '/electric-rice-cooker-manufacturer': 'Arroceras eléctricas',
  '/electric-pressure-cooker-manufacturer': 'Ollas a presión eléctricas',
  '/electric-lunch-box-manufacturer': 'Fiambreras eléctricas',
  '/hand-blender-manufacturer': 'Batidoras de mano',
  '/multi-cooker-manufacturer': 'Ollas multifunción',
};
const catName = CAT_NAME[catPage] || model.catEs;
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://oemkitchenchina.xyz/' },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: 'https://oemkitchenchina.xyz/productos' },
    { '@type': 'ListItem', position: 3, name: catName, item: 'https://oemkitchenchina.xyz' + catPage },
    { '@type': 'ListItem', position: 4, name: model.sku + ' · ' + model.catEs },
  ],
};

const specs = Object.entries(model.specs);

const content = CAT_CONTENT[model.category] ?? CAT_CONTENT['electric-water-kettle'];

const cap = model.specs['Capacity'] ?? '';
const power = model.specs['Power'] ?? '';
const volt = model.specs['Voltage/Frequency'] ?? '';
const rawMaterial = model.specs['Inner Material'] ?? model.specs['Material'] ?? '';
const material = rawMaterial
  .replace('Food-Grade SUS304 Stainless Steel', 'acero inoxidable SUS304')
  .replace('Food-Grade SUS304', 'acero SUS304')
  .replace('SUS304 Stainless Steel', 'acero inoxidable SUS304')
  .replace('Stainless Steel', 'acero inoxidable')
  .replace('Borosilicate Glass', 'vidrio borosilicato')
  .replace('Glass', 'vidrio')
  .replace('Aluminum', 'aluminio')
  .replace('Non-stick', 'antiadherente')
  .trim();
const certs = model.specs['Certifications'] ?? '';

const specSentence = [
  cap && `capacidad de ${cap}`,
  power && `potencia de ${power}`,
  material && `interior de ${material}`,
  volt && `para ${volt}`,
]
  .filter(Boolean)
  .join(', ');

const features = model.featuresEs.length > 0 ? model.featuresEs : content.defaultFeatures;

const attrs = describeAttributes(model.titleEn);

// Artículos del blog relacionados con la línea del modelo: refuerza el clúster
// temático y da al comprador contenido de apoyo sin salir del sitio.
const RELATED_POSTS: Record<string, RegExp> = {
  'electric-water-kettle': /hervidor|kettle/i,
  'glass-electric-kettle': /vidrio|glass|hervidor/i,
  'electric-coffee-kettle': /cuello de cisne|gooseneck|barista|café|coffee/i,
  'electric-health-kettle': /salud|health|hervidor/i,
  'electric-kettle-set': /set|juego|hervidor/i,
  'breakfast-machine': /desayuno|breakfast|hervidor/i,
  'pressure-cooker': /olla a presión|pressure cooker|olla presión/i,
  'multi-cooker': /multifunción|multi-cooker|olla/i,
  'mini-cooker': /arrocera|rice cooker|arroz|olla/i,
  'low-sugar-cooker': /arroz|rice|bajo azúcar|low sugar|arrocera/i,
  'ih-cooker': /inducción|ih|arrocera|arroz/i,
  'electric-lunch-box': /fiambrera|lunch box|comida/i,
};
const postPattern = RELATED_POSTS[model.category] ?? /hervidor/i;
const blogPosts = (await getCollection('post'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0));
const relatedPosts = blogPosts
  .filter((p) =>
    postPattern.test(
      `${p.data.title} ${p.data.excerpt ?? ''} ${p.data.category ?? ''} ${(p.data.tags ?? []).join(' ')}`
    )
  )
  .slice(0, 3);

// Datos técnicos del modelo como propiedades estructuradas: no inventamos precios,
// porque YOLEC trabaja bajo cotización FOB y no publica tarifas.
Object.assign(productSchema, {
  additionalProperty: [
    cap && { '@type': 'PropertyValue', name: 'Capacidad', value: cap },
    power && { '@type': 'PropertyValue', name: 'Potencia', value: power },
    material && { '@type': 'PropertyValue', name: 'Material interior', value: material },
    volt && { '@type': 'PropertyValue', name: 'Voltaje', value: volt },
    certs && { '@type': 'PropertyValue', name: 'Certificaciones', value: certs },
  ].filter(Boolean),
});

const faqs = [
  {
    q: `¿Qué especificaciones tiene el modelo ${model.sku}?`,
    a: specSentence
      ? `El ${model.sku} se fabrica con ${specSentence}.${certs ? ` Las certificaciones disponibles para esta referencia son ${certs}.` : ''}`
      : `El modelo ${model.sku} forma parte de nuestra línea de ${model.catEs.toLowerCase()} y sus especificaciones se ajustan por proyecto según el mercado de destino.`,
  },
  {
    q: '¿Puedo fabricarlo con mi propia marca?',
    a: `${content.customization} Trabajamos con MOQ de 500 unidades por modelo y aprobación de muestra antes de producir.`,
  },
  {
    q: '¿Qué certificaciones puede incluir?',
    a: certs
      ? `Las certificaciones habituales de esta referencia son ${certs}. Si su mercado exige otra norma, la tramitamos durante el desarrollo del proyecto.`
      : 'Trabajamos con CE y RoHS como base; otras normas se definen según el mercado de destino.',
  },
  {
    q: '¿Cuánto tarda la muestra y la producción?',
    a: 'La muestra se entrega en 7 a 10 días y la producción en masa en 25 a 30 días desde la aprobación, según volumen y acabado.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  metadata={{
    title: model.titleEs,
    description: model.descEs,
    ignoreTitleTemplate: true,
    openGraph: {
      images: [{ url: model.images[0], alt: `${model.titleEs} - fabricante OEM en China` }],
    },
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- BREADCRUMB -->

  <section class="border-b border-slate-200 bg-white py-4 dark:border-slate-800 dark:bg-slate-950">
    <nav class="mx-auto max-w-7xl px-6 text-sm text-slate-500 lg:px-8 dark:text-slate-400">
      <a href="/" class="hover:text-accent">Inicio</a>
      <span class="mx-2">/</span>
      <a href="/productos" class="hover:text-accent">Catálogo</a>
      <span class="mx-2">/</span>
      <a href={catPage} class="hover:text-accent">{model.catEs}</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900 dark:text-white">{model.sku}</span>
    </nav>
  </section>

  <!-- HERO -->

  <section class="bg-slate-50 py-16 dark:bg-slate-900 lg:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid items-start gap-12 lg:grid-cols-2">
        <div class="grid gap-4">
          <div
            class="overflow-hidden rounded-2xl bg-white shadow-lg ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700"
          >
            <picture>
              <source srcset={toWebp(model.images[0] || '/images/blog/38.jpg')} type="image/webp" />
              <img
                src={model.images[0] || '/images/blog/38.jpg'}
                alt={`${model.titleEs} - fabricante OEM en China`}
                width="750"
                height="750"
                class="h-auto w-full object-cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
          {
            model.images[1] && (
              <div class="overflow-hidden rounded-2xl bg-white shadow ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700">
                <picture>
                  <source srcset={toWebp(model.images[1])} type="image/webp" />
                  <img
                    src={model.images[1]}
                    alt={`${model.titleEs} - detalle del producto`}
                    width="750"
                    height="750"
                    class="h-auto w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </div>
            )
          }
        </div>

        <div>
          <div
            class="mb-5 inline-flex items-center rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
          >
            Modelo: {model.sku} · OEM / ODM
          </div>

          <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
            {model.titleEs}
          </h1>

          <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">{model.descEs}</p>

          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="/contacto"
              class="inline-flex items-center rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
            >
              Solicitar Cotización
            </a>

            <a
              href="https://wa.me/8613922332584"
              class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"
            >
              Hablar por WhatsApp
            </a>
          </div>

          <!-- SPECS TABLE -->

          {
            specs.length > 0 && (
              <div class="mt-10 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800">
                <table class="w-full text-left text-sm">
                  <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                    {specs.map(([k, v]) => (
                      <tr>
                        <th class="w-2/5 bg-slate-100 px-5 py-3.5 font-semibold text-slate-700 dark:bg-slate-800/60 dark:text-slate-300">
                          {SPEC_LABELS[String(k)] || String(k)}
                        </th>
                        <td class="px-5 py-3.5 text-slate-900 dark:text-white">{trVal(String(v))}</td>
                      </tr>
                    ))}
                    <tr>
                      <th class="w-2/5 bg-slate-100 px-5 py-3.5 font-semibold text-slate-700 dark:bg-slate-800/60 dark:text-slate-300">
                        Personalización
                      </th>
                      <td class="px-5 py-3.5 text-slate-900 dark:text-white">
                        Logotipo, color, packaging y especificaciones (OEM/ODM)
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->

  {
    features.length > 0 && (
      <section class="bg-white py-16 dark:bg-slate-950 lg:py-20">
        <div class="mx-auto max-w-5xl px-6 lg:px-8">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
            Características principales del modelo {model.sku}
          </h2>

          <ul class="mt-8 grid gap-4 sm:grid-cols-2">
            {features.map((f) => (
              <li class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 px-5 py-4 text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
                <span class="text-accent">✓</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- MODEL CONTENT -->

  <section class="bg-slate-50 py-16 dark:bg-slate-900 lg:py-20">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
        El modelo {model.sku} en la línea de {model.catEs.toLowerCase()}
      </h2>

      <div class="mt-6 space-y-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
        <p>{content.intro}</p>

        <p>
          La referencia {model.sku} sale de nuestra planta de Zhongshan{cap ? ` en versión de ${cap}` : ''}{
            power ? `, con ${power}` : ''
          }{material ? ` e interior de ${material}` : ''}{volt ? `, preparada para ${volt}` : ''}.{
            certs ? ` Se entrega con ${certs}.` : ''
          }
        </p>
      </div>

      <div class="mt-12 grid gap-10 sm:grid-cols-2">
        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Aplicaciones y mercados</h3>
          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{content.applications}</p>
        </div>

        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Personalización OEM / ODM</h3>
          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">
            {content.customization} MOQ de 500 unidades por modelo, muestra en 7–10 días y producción en 25–30 días desde
            la aprobación del prototipo.
          </p>
        </div>

        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Control de calidad</h3>
          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">{content.quality}</p>
        </div>

        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Perfil de comprador</h3>
          <p class="mt-3 leading-7 text-slate-600 dark:text-slate-300">
            {content.buyers} Fabricamos para Europa y América Latina desde 2015, con 20.000 m² de planta y auditoría SGS 483515034-P+T.
          </p>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/contacto"
          class="inline-flex items-center rounded-lg bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
        >
          Solicitar Cotización del Modelo {model.sku}
        </a>

        <a
          href={catPage}
          class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:border-slate-600 dark:bg-slate-800 dark:text-white dark:hover:bg-slate-700"
        >
          Ver toda la línea de {model.catEs}
        </a>
      </div>
    </div>
  </section>

  <!-- ATTRIBUTES -->

  {
    attrs.length > 0 && (
      <section class="bg-white py-16 dark:bg-slate-950 lg:py-20">
        <div class="mx-auto max-w-5xl px-6 lg:px-8">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
            Qué distingue la referencia {model.sku}
          </h2>

          <p class="mt-4 leading-7 text-slate-600 dark:text-slate-300">
            Comparte la base técnica de la línea de {model.catEs.toLowerCase()}, pero incorpora
            {attrs.map((a) => a.label).join(', ')}.
          </p>

          <ul class="mt-8 grid gap-4 sm:grid-cols-2">
            {attrs.map((a) => (
              <li class="rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900">
                <h3 class="font-semibold text-slate-900 dark:text-white">{a.label}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{a.detail}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- FAQ -->

  <section class="bg-slate-50 py-16 dark:bg-slate-900 lg:py-20">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
        Preguntas frecuentes sobre el {model.sku}
      </h2>

      <div class="mt-8 divide-y divide-slate-200 dark:divide-slate-800">
        {
          faqs.map((f) => (
            <div class="py-5">
              <h3 class="font-semibold text-slate-900 dark:text-white">{f.q}</h3>
              <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">{f.a}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- RELATED MODELS -->

  {
    siblings.length > 0 && (
      <section class="bg-white py-16 dark:bg-slate-950 lg:py-20">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
            Modelos relacionados de {model.catEs}
          </h2>

          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {siblings.map((s) => (
              <a
                href={`/products/${s.category}/${s.slug}`}
                class="group overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 transition duration-300 hover:-translate-y-1 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900"
              >
                <div class="aspect-square overflow-hidden bg-white dark:bg-slate-800">
                  <picture>
                    <source srcset={toWebp(s.images[0] || '/images/blog/38.jpg')} type="image/webp" />
                    <img
                      src={s.images[0] || '/images/blog/38.jpg'}
                      alt={`${s.titleEs} OEM`}
                      width="750"
                      height="750"
                      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                    />
                  </picture>
                </div>

                <div class="p-5">
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">{s.sku}</p>

                  <h3 class="mt-2 line-clamp-2 text-sm font-bold leading-5 text-slate-900 transition group-hover:text-accent dark:text-white">
                    {s.titleEs}
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- RELATED POSTS -->

  {
    relatedPosts.length > 0 && (
      <section class="bg-slate-50 py-16 dark:bg-slate-900 lg:py-20">
        <div class="mx-auto max-w-5xl px-6 lg:px-8">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
            Guías para comprar {model.catEs.toLowerCase()} al por mayor
          </h2>

          <p class="mt-4 leading-7 text-slate-600 dark:text-slate-300">
            Contenido técnico y de compras que complementa la ficha de este modelo.
          </p>

          <ul class="mt-8 grid gap-5 sm:grid-cols-3">
            {relatedPosts.map((p) => (
              <li>
                <a
                  href={`/blog/${p.id}`}
                  class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-lg dark:border-slate-800 dark:bg-slate-800"
                >
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                    {p.data.category ?? 'Guía OEM'}
                  </p>
                  <h3 class="mt-2 text-sm font-bold leading-5 text-slate-900 dark:text-white">{p.data.title}</h3>
                  <p class="mt-2 line-clamp-3 text-xs leading-5 text-slate-600 dark:text-slate-300">{p.data.excerpt}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- WHATSAPP QR -->

  <div class="flex flex-col items-center justify-center gap-3 bg-white py-10 dark:bg-slate-950">
    <p class="text-center text-sm text-slate-500 dark:text-slate-400">Contacto directo para consultas OEM / ODM</p>

    <img
      src="/images/whatsapp.png"
      alt="WhatsApp de YOLEC Electric para consultas sobre el modelo {model.sku}"
      class="h-auto w-[180px] rounded-lg shadow-md md:w-[220px]"
      loading="lazy"
    />
  </div>
</Layout>
