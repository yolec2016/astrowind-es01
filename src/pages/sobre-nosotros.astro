---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Sobre Nosotros | YOLEC Electric',
  description:
    'Conozca YOLEC Electric: fábrica de 20.000 m², más de 200 empleados y certificaciones CE, CB, RoHS y LFGB. Fabricante OEM/ODM de pequeños electrodomésticos.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- HERO -->
  <Hero
    tagline="Fabricante OEM y ODM de Electrodomésticos en China"
    title="YOLEC Electric: Fabricante OEM y ODM de Pequeños Electrodomésticos para Marcas Globales"
    subtitle="YOLEC Electric es un fabricante profesional de pequeños electrodomésticos ubicado en Zhongshan, China. Desde 2015 ayudamos a importadores, distribuidores, cadenas minoristas y propietarios de marcas a desarrollar y fabricar hervidores eléctricos, hervidores de cuello de cisne, arroceras, ollas a presión eléctricas, fiambreras eléctricas y batidoras de mano mediante soluciones OEM y ODM completas. Con producción directa de fábrica, un estricto sistema de control de calidad y una amplia experiencia en exportación, ofrecemos productos fiables para mercados de Europa, América, Oriente Medio y otras regiones."
    image={{
      src: '~/assets/images/yolec.png',
      alt: 'Fábrica OEM y ODM de pequeños electrodomésticos en Zhongshan, China - YOLEC Electric',
    }}
  />
  <!-- STATS -->
  <Stats
    title="Capacidad de fabricación"
    stats={[
      { title: 'Años de experiencia', amount: '10+' },
      { title: 'Capacidad mensual', amount: '300K+' },
      { title: 'Clientes B2B', amount: '200+' },
      { title: 'Líneas de producción', amount: '3' },
    ]}
  />

  <!-- DATOS CLAVE (tabla extraíble para buscadores y asistentes de IA) -->
  <section class="bg-white py-16 dark:bg-slate-950 lg:py-20">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
        Datos clave de YOLEC Electric
      </h2>

      <p class="mt-3 text-slate-600 dark:text-slate-300">
        Resumen verificable de la empresa, la fábrica y las condiciones comerciales habituales.
      </p>

      <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800">
        <table class="w-full text-left text-sm">
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            {
              [
                ['Nombre comercial', 'YOLEC Electric'],
                ['Tipo de proveedor', 'Fabricante directo con fábrica propia (no trading company)'],
                ['Año de fundación', '2015'],
                ['Ubicación', 'Zhongshan, Guangdong, China'],
                ['Superficie de fábrica', '20.000 m²'],
                ['Empleados', 'Más de 200'],
                ['Líneas de producción', '3'],
                ['Capacidad', 'Más de 300.000 unidades al mes'],
                ['Auditoría de fábrica', 'SGS, informe 483515034-P+T'],
                ['Certificaciones de producto', 'CE, CB, RoHS, LFGB, CCC, TÜV, ETL, Intertek'],
                ['MOQ', 'Desde 500 unidades por modelo'],
                ['Muestra personalizada', '7 a 10 días'],
                ['Producción en serie', '25 a 30 días desde la aprobación'],
                ['Referencias en catálogo', '110 modelos en 12 categorías'],
                ['Mercados de exportación', 'Más de 60 países'],
                ['Idiomas de atención', 'Español, inglés y chino'],
              ].map(([label, value]) => (
                <tr>
                  <th class="w-1/3 bg-slate-50 px-5 py-3 font-semibold text-slate-900 dark:bg-slate-900 dark:text-white">
                    {label}
                  </th>
                  <td class="px-5 py-3 text-slate-600 dark:text-slate-300">{value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CERT STRIP -->
  <section class="border-y border-slate-200 bg-white py-10 dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto max-w-5xl px-6 text-center lg:px-8">
      <h2 class="text-lg font-bold uppercase tracking-wide text-slate-900 dark:text-white">
        Certificaciones: CE · RoHS · CB · CCC · TÜV · ETL · LFGB · Intertek
      </h2>

      <p class="mt-2 text-slate-600 dark:text-slate-300">
        Calidad verificada por organismos internacionales.
        <a href="/fabrica" class="font-semibold text-accent hover:underline"
          >Ver certificados y talleres de producción →</a
        >
      </p>
    </div>
  </section>

  <!-- FEATURES -->
  <Features3
    title="¿Por qué elegir YOLEC Electric?"
    subtitle="Somos un fabricante OEM y ODM especializado en pequeños electrodomésticos para clientes B2B de todo el mundo, ofreciendo desarrollo de productos, producción personalizada y estrictos controles de calidad."
    columns={3}
    items={[
      {
        title: 'Fabricación OEM/ODM',
        description: 'Desarrollamos productos personalizados según la marca y necesidades del cliente.',
        icon: 'tabler:building-factory',
      },
      {
        title: 'Control de calidad estricto',
        description: 'Inspección en cada etapa de producción para garantizar estándares internacionales.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Ingeniería propia',
        description: 'Equipo de diseño y desarrollo para soluciones ODM completas.',
        icon: 'tabler:settings-cog',
      },
      {
        title: 'Exportación global',
        description: 'Experiencia en envío a Europa, América, Oriente Medio y Asia.',
        icon: 'tabler:world',
      },
      {
        title: 'Producción flexible',
        description: 'Adaptamos el MOQ y la capacidad según el tipo de cliente.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Soporte B2B directo',
        description: 'Comunicación directa con fábrica sin intermediarios.',
        icon: 'tabler:messages',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <Content
    isReversed
    tagline="VISITE NUESTRA FÁBRICA"
    title="Le invitamos a visitar nuestra fábrica en China"
    image={{
      src: '~/assets/images/factory3.png',
      alt: 'Clientes internacionales visitando la fábrica de YOLEC Electric en China',
    }}
  >
    <Fragment slot="content">
      <p class="mb-5">
        Siempre damos una cálida bienvenida a nuestros clientes y socios comerciales para visitar nuestra fábrica en
        Zhongshan, Guangdong, China.
      </p>

      <p class="mb-5">
        Durante la visita podrá conocer nuestras líneas de producción, procesos de fabricación, laboratorio de pruebas,
        sistema de control de calidad y equipo de ingeniería.
      </p>

      <p class="mb-5">
        Creemos que una visita presencial es la mejor manera de conocer nuestra capacidad de fabricación y establecer
        una relación de cooperación basada en la confianza.
      </p>

      <p>
        Nuestro equipo estará encantado de organizar la recepción, el recorrido por la fábrica y reuniones técnicas para
        ayudarle a comprender mejor nuestras soluciones OEM y ODM.
      </p>
    </Fragment>
  </Content>

  <!-- PROCESS -->
  <Steps2
    title="Nuestro proceso de cooperación OEM y ODM"
    subtitle="Desde la consulta inicial hasta la entrega internacional, ofrecemos un proceso eficiente y transparente para compradores profesionales."
    items={[
      {
        title: 'Consulta del proyecto',
        description: 'Analizamos requisitos del producto, mercado objetivo y volumen.',
      },
      {
        title: 'Propuesta OEM/ODM',
        description: 'Recomendamos modelo de fabricación y solución técnica.',
      },
      {
        title: 'Diseño y muestra',
        description: 'Desarrollo de prototipo o adaptación de modelo existente.',
      },
      {
        title: 'Producción en masa',
        description: 'Fabricación bajo control de calidad estricto.',
      },
      {
        title: 'Inspección final',
        description: 'Revisión AQL y pruebas funcionales antes del envío.',
      },
      {
        title: 'Entrega global',
        description: 'Logística internacional y soporte documental de exportación.',
      },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Solicitar Cotización OEM',
        href: '/contacto',
        icon: 'tabler:mail',
      },
      {
        text: 'Contactar por WhatsApp',
        href: 'https://wa.me/8613922332584',
      },
    ]}
  >
    <Fragment slot="title"> ¿Busca un fabricante OEM y ODM confiable en China? </Fragment>

    <Fragment slot="subtitle">
      Nuestro equipo está preparado para ayudarle a desarrollar nuevos productos, fabricar con su propia marca y ofrecer
      soluciones OEM y ODM adaptadas a su mercado. Contáctenos hoy mismo para recibir una propuesta personalizada.
    </Fragment>
  </CallToAction>
</Layout>
