---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Servicios OEM y ODM | YOLEC Electric',
  description:
    'YOLEC Electric ofrece servicios OEM y ODM de hervidores eléctricos, arroceras, ollas a presión, fiambreras y batidoras. Fabricación directa de fábrica en China.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    tagline="Servicios OEM/ODM"
    title="Fabricación OEM y ODM de electrodomésticos en China"
    subtitle="Somos un fabricante en China especializado en electrodomésticos de cocina. Ofrecemos soluciones OEM y ODM para hervidores eléctricos, arroceras, ollas a presión, fiambreras eléctricas y batidoras de mano para clientes globales."
    actions={[{ variant: 'primary', target: '_blank', text: 'Contacto', href: '/contacto' }]}
    image={{
      src: '~/assets/images/factory.png',
      alt: 'Fábrica OEM ODM electrodomésticos China',
    }}
  />

  <!-- Features -->
  <Features2
    title="Servicios principales"
    subtitle="Soluciones OEM y ODM para marcas, distribuidores e importadores."
    columns={3}
    items={[
      {
        title: 'OEM',
        description: 'Fabricamos productos con su marca, diseño y embalaje personalizado.',
      },
      {
        title: 'ODM',
        description: 'Ofrecemos modelos existentes que se pueden personalizar para su mercado.',
      },
      {
        title: 'Control de calidad',
        description: 'Inspección en cada etapa de producción para garantizar calidad estable.',
      },
      {
        title: 'Desarrollo de productos',
        description: 'Apoyo en diseño y desarrollo de nuevos productos.',
      },
      {
        title: 'Producción en masa',
        description: 'Capacidad para pedidos grandes y pequeños con entrega estable.',
      },
      {
        title: 'Precio de fábrica',
        description: 'Suministro directo sin intermediarios.',
      },
    ]}
  />

  <!-- Content 1 -->
  <Content
    isReversed
    items={[
      {
        title: 'Diseño OEM/ODM',
        description: 'Transformamos su idea en un producto listo para producción.',
      },
      {
        title: 'Muestras rápidas',
        description: 'Desarrollo de prototipos para validación del mercado.',
      },
      {
        title: 'Producción estable',
        description: 'Líneas de fabricación modernas para pedidos continuos.',
      },
      {
        title: 'Inspección final',
        description: 'Control de calidad antes del envío.',
      },
    ]}
    image={{
      src: '~/assets/images/factory3.png',
      alt: 'Proceso de fabricación OEM ODM',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold">Proceso de fabricación</h3>
    </Fragment>
  </Content>

  <!-- Content 2 -->
  <Content
    isAfterContent
    items={[
      {
        title: 'Ahorro de tiempo',
        description: 'Reducimos el tiempo de desarrollo de producto.',
      },
      {
        title: 'Alta calidad',
        description: 'Fabricación bajo estándares internacionales.',
      },
      {
        title: 'Costo competitivo',
        description: 'Precio directo de fábrica.',
      },
      {
        title: 'Entrega rápida',
        description: 'Producción optimizada para exportación.',
      },
    ]}
    image={{
      src: '~/assets/images/factory2.png',
      alt: 'Ventajas OEM ODM',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold">Ventajas</h3>
    </Fragment>
  </Content>

  <!-- Modelos de colaboración -->
  <section class="bg-slate-50 py-16 dark:bg-slate-900 lg:py-20">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        OEM, ODM o marca blanca: qué modelo encaja con su proyecto
      </h2>

      <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">
        Los tres modelos parten de nuestra fábrica, pero cambian el punto de partida del diseño y el reparto de
        responsabilidades. Elegir mal al principio es la causa más habitual de retrasos en la primera producción.
      </p>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-800">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">OEM</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
            Usted aporta el diseño, el plano o la referencia del producto y nosotros fabricamos con su marca. Es la vía
            habitual para marcas con equipo de diseño propio y para importadores que ya tienen un producto validado en
            otro proveedor.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-800">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">ODM</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
            Partimos de un modelo ya desarrollado en nuestro catálogo y lo adaptamos a su mercado: color, acabado,
            panel, funciones, enchufe y packaging. Reduce el plazo de desarrollo porque el molde y la electrónica ya
            están validados.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-800">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">Marca blanca</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
            Producto estándar de catálogo con su logo y su packaging, sin cambios de diseño. Es la opción más rápida y
            de menor coste para probar un mercado o completar una gama.
          </p>
        </div>
      </div>

      <p class="mt-8 leading-7 text-slate-600 dark:text-slate-300">
        En la práctica, muchos proyectos empiezan como marca blanca, pasan a ODM en la segunda temporada y terminan como
        OEM cuando la marca tiene volumen suficiente para asumir moldes propios. Podemos acompañar ese recorrido sin
        cambiar de proveedor.
      </p>
    </div>
  </section>

  <!-- Proceso -->
  <section class="bg-white py-16 dark:bg-slate-950 lg:py-20">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Proceso de un proyecto OEM, paso a paso
      </h2>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div>
          <h3 class="font-bold text-slate-900 dark:text-white">1. Briefing técnico — 24 a 48 horas</h3>
          <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">
            Definimos producto, capacidad, potencia, mercado de destino, certificación requerida y volumen anual
            estimado. Con esos datos podemos decir si conviene un molde nuevo o un modelo existente.
          </p>
        </div>

        <div>
          <h3 class="font-bold text-slate-900 dark:text-white">2. Cotización detallada — 24 horas</h3>
          <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">
            Recibe precio FOB, MOQ por modelo, coste de molde o utilaje cuando aplica, y plazo de producción. Sin rangos
            abiertos ni condiciones que cambian después.
          </p>
        </div>

        <div>
          <h3 class="font-bold text-slate-900 dark:text-white">3. Muestra — 7 a 10 días</h3>
          <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">
            Fabricamos la muestra con su logo, color y acabado. Se envía por mensajería y se revisa con la lista de
            comprobación que usamos en producción, no solo a ojo.
          </p>
        </div>

        <div>
          <h3 class="font-bold text-slate-900 dark:text-white">4. Aprobación y pedido</h3>
          <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">
            La muestra aprobada queda como golden sample y se bloquean las especificaciones críticas en el pedido:
            material, potencia, cable, termostato y acabado.
          </p>
        </div>

        <div>
          <h3 class="font-bold text-slate-900 dark:text-white">5. Producción — 25 a 30 días</h3>
          <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">
            Cinco líneas en producción continua con capacidad superior a 300.000 unidades al mes. Recibe avance
            fotográfico en las etapas acordadas.
          </p>
        </div>

        <div>
          <h3 class="font-bold text-slate-900 dark:text-white">6. Inspección y salida</h3>
          <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">
            Inspección final con criterios AQL, prueba eléctrica al 100% e informe fotográfico antes del despacho desde
            Zhongshan o Shenzhen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Personalización -->
  <section class="bg-slate-50 py-16 dark:bg-slate-900 lg:py-20">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">Qué se puede personalizar</h2>

      <p class="mt-4 text-lg leading-8 text-slate-600 dark:text-slate-300">
        La personalización se define por proyecto. Estos son los puntos que modificamos con más frecuencia y que afectan
        directamente al coste y al plazo.
      </p>

      <ul class="mt-8 grid gap-4 text-slate-600 dark:text-slate-300 sm:grid-cols-2">
        <li class="rounded-xl bg-white p-5 dark:bg-slate-800">
          <strong class="text-slate-900 dark:text-white">Logo y marca</strong> — serigrafía, tampografía o grabado láser sobre
          el cuerpo, el asa o la base.
        </li>
        <li class="rounded-xl bg-white p-5 dark:bg-slate-800">
          <strong class="text-slate-900 dark:text-white">Color y acabado</strong> — brillante, mate, soft-touch o pintura
          personalizada con muestra de color aprobada.
        </li>
        <li class="rounded-xl bg-white p-5 dark:bg-slate-800">
          <strong class="text-slate-900 dark:text-white">Materiales</strong> — cuerpo exterior, interior en contacto con el
          agua y tipo de recubrimiento.
        </li>
        <li class="rounded-xl bg-white p-5 dark:bg-slate-800">
          <strong class="text-slate-900 dark:text-white">Panel y funciones</strong> — programas, pantalla, menú en el idioma
          del mercado y límites de temperatura.
        </li>
        <li class="rounded-xl bg-white p-5 dark:bg-slate-800">
          <strong class="text-slate-900 dark:text-white">Enchufe y voltaje</strong> — 220–240 V o 110–127 V, clavija europea,
          británica, americana o brasileña.
        </li>
        <li class="rounded-xl bg-white p-5 dark:bg-slate-800">
          <strong class="text-slate-900 dark:text-white">Packaging</strong> — caja de color, estuche rígido, manual, etiquetado
          y código de barras.
        </li>
        <li class="rounded-xl bg-white p-5 dark:bg-slate-800">
          <strong class="text-slate-900 dark:text-white">Etiquetado normativo</strong> — marcado CE, datos del fabricante
          y advertencias según el país de destino.
        </li>
        <li class="rounded-xl bg-white p-5 dark:bg-slate-800">
          <strong class="text-slate-900 dark:text-white">Accesorios</strong> — cucharas, cestas, bandejas, bases adicionales
          y manuales impresos.
        </li>
      </ul>
    </div>
  </section>

  <!-- Capacidad -->
  <section class="bg-white py-16 dark:bg-slate-950 lg:py-20">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Capacidad de producción y control de calidad
      </h2>

      <div class="mt-6 space-y-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
        <p>
          La planta ocupa 20.000 m² en Dongfeng, Zhongshan, con más de 200 empleados y 13 ingenieros en el departamento
          de I+D. Contamos con taller propio de inyección con más de 30 máquinas de 250 a 420 toneladas, taller de
          estampación metálica y cinco líneas de montaje en producción continua.
        </p>

        <p>
          La capacidad supera las 300.000 unidades al mes, con un MOQ de 500 unidades por modelo. Cada lote pasa pruebas
          eléctricas al 100%, verificación de función y control dimensional, y documentamos los resultados antes del
          envío. La planta está auditada por SGS con el informe 483515034-P+T.
        </p>

        <p>
          Trabajamos con certificaciones CE, CB, RoHS, LFGB, ETL e Intertek según el mercado de destino. Cuando la norma
          exige ensayos externos, se realizan durante el desarrollo del proyecto para no bloquear la producción.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-4">
        <div class="rounded-2xl bg-slate-50 p-6 text-center dark:bg-slate-800">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">20.000 m²</div>
          <div class="mt-1 text-sm text-slate-500">planta en Zhongshan</div>
        </div>

        <div class="rounded-2xl bg-slate-50 p-6 text-center dark:bg-slate-800">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">300.000+</div>
          <div class="mt-1 text-sm text-slate-500">unidades al mes</div>
        </div>

        <div class="rounded-2xl bg-slate-50 p-6 text-center dark:bg-slate-800">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">500</div>
          <div class="mt-1 text-sm text-slate-500">MOQ por modelo</div>
        </div>

        <div class="rounded-2xl bg-slate-50 p-6 text-center dark:bg-slate-800">
          <div class="text-2xl font-bold text-slate-900 dark:text-white">SGS</div>
          <div class="mt-1 text-sm text-slate-500">483515034-P+T</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="bg-slate-50 py-16 dark:bg-slate-900 lg:py-20">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
        Preguntas frecuentes sobre OEM y ODM
      </h2>

      <div class="mt-8 divide-y divide-slate-200 dark:divide-slate-800">
        <div class="py-5">
          <h3 class="font-semibold text-slate-900 dark:text-white">¿Cuál es el MOQ mínimo?</h3>
          <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">
            500 unidades por modelo y acabado. Para una primera prueba de mercado se puede valorar un volumen menor
            cuando el modelo ya está en catálogo y no requiere utilaje nuevo.
          </p>
        </div>

        <div class="py-5">
          <h3 class="font-semibold text-slate-900 dark:text-white">¿Cuánto cuesta un molde propio?</h3>
          <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">
            Depende de la pieza y del número de cavidades. Se cotiza junto con el producto y queda a nombre del cliente
            cuando el proyecto lo requiere.
          </p>
        </div>

        <div class="py-5">
          <h3 class="font-semibold text-slate-900 dark:text-white">¿Puedo ver la fábrica antes de pedir?</h3>
          <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">
            Sí. Se puede visitar la planta en Zhongshan con cita previa, o solicitar una auditoría de terceros. También
            enviamos vídeo de las líneas y del almacén cuando la visita no es posible.
          </p>
        </div>

        <div class="py-5">
          <h3 class="font-semibold text-slate-900 dark:text-white">¿Qué documentación entregan?</h3>
          <p class="mt-2 leading-7 text-slate-600 dark:text-slate-300">
            Factura comercial, packing list, certificado de origen, informes de ensayo de las certificaciones aplicables
            e informe de inspección final con fotografías.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <Testimonials
    title="Clientes internacionales"
    testimonials={[
      {
        testimonial: 'Buen proveedor OEM, calidad estable y comunicación profesional.',
        name: 'Cliente Internacional',
        job: 'Importador',
        image: {
          src: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e',
          alt: 'Cliente',
        },
      },
      {
        testimonial: 'Excelente servicio ODM y entrega puntual.',
        name: 'Distribuidor',
        job: 'Mayorista',
        image: {
          src: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2',
          alt: 'Cliente',
        },
      },
      {
        testimonial: 'Muy buen soporte técnico en desarrollo de producto.',
        name: 'Dueño de marca',
        job: 'Brand Owner',
        image: {
          src: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d',
          alt: 'Cliente',
        },
      },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Solicitar cotización',
        href: '/contacto',
      },
    ]}
    title="Fabricación OEM/ODM en China"
    subtitle="Electrodomésticos de cocina personalizados para su marca."
  />
</Layout>
